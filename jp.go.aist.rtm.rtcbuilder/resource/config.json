    "mapping_db": {
        "_comment": "Logical Library Name to Physical Package Mapping Database",
        "default_libs": {
            "_comment": "Libraries that are automatically added by the Dockerfile generator. These lists are kept in this external file instead of hard-coding them in Python code.",
            "common": [
                "build-essential",
                "cmake",
                "git",
                "libboost-all-dev",
                "python3-pip"
            ],
            "by_middleware": {
                "ros1": [
                    "python3-catkin-tools",
                    "python3-rosdep",
                    "python3-rosinstall",
                    "python3-rosinstall-generator",
                    "python3-wstool"
                ],
                "ros2": [
                    "python3-colcon-common-extensions",
                    "python3-rosdep"
                ],
                "openrtm": [
                    "python3-dev",
                    "omniidl",
                    "omniorb-nameserver",
                    "doxygen",
                    "openrtm-aist-dev",
                    "pkg-config",
                    "uuid-dev"
                ]
            },
            "by_language": {
                "ros1": {
                    "python": [
                        "rospy"
                    ]
                },
                "ros2": {
                    "c++": [
                        "rclcpp"
                    ],
                    "python": [
                        "rclpy",
                        "python3-setuptools"
                    ]
                },
                "openrtm": {}
            },
            "by_os_condition": [
                {
                    "name": "openrtm_python_is_python3",
                    "middleware": "openrtm",
                    "exclude_os_versions": [
                        "18.04",
                        "16.04"
                    ],
                    "libs": [
                        "python-is-python3"
                    ]
                }
            ],
            "conditional": [
                {
                    "name": "gui_sim",
                    "description": "Add X11/OpenGL helper packages when GUI or simulation related libraries are requested.",
                    "triggers": [
                        "rviz",
                        "rviz2",
                        "gazebo_ros",
                        "rqt_gui",
                        "opencv2",
                        "vision_opencv"
                    ],
                    "libs": [
                        "x11-apps",
                        "mesa-utils",
                        "libgl1-mesa-glx",
                        "libgl1-mesa-dri"
                    ]
                },
                {
                    "name": "hardware_control",
                    "description": "Add low-level device library when hardware-control related libraries are requested.",
                    "triggers": [
                        "dynamixel_sdk",
                        "DynamixelSDK",
                        "pyserial",
                        "ros_control",
                        "ros2_control",
                        "usb_cam"
                    ],
                    "libs": [
                        "libudev-dev"
                    ]
                }
            ]
        },
