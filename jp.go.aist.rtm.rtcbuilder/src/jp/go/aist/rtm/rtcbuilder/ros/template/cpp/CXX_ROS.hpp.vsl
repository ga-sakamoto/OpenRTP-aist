${sharp}ifndef ${rosParam.packageName.toUpperCase()}__${rosParam.nodeName.toUpperCase()}_HPP_
${sharp}define ${rosParam.packageName.toUpperCase()}__${rosParam.nodeName.toUpperCase()}_HPP_

#if( ${rosParam.topicPublishes.size()}>0 )
#foreach($topic in ${rosParam.topicPublishes})
${sharp}include "${topic.messageType.toLowerCase()}.hpp"
#end
#end
#if( ${rosParam.actionClients.size()}>0 || ${rosParam.actionServers.size()}>0 )
#foreach($action in ${rosParam.actionClients})
${sharp}include "${action.type.toLowerCase()}.hpp"
#end
#foreach($action in ${rosParam.actionServers})
${sharp}include "${action.type.toLowerCase()}.hpp"
#end
#end
${sharp}include "rclcpp/rclcpp.hpp"
#if( ${rosParam.actionClients.size()}>0 || ${rosParam.actionServers.size()}>0 )
${sharp}include "rclcpp_action/rclcpp_action.hpp"
#end
${sharp}include "rclcpp_lifecycle/lifecycle_node.hpp"
#if( ${rosParam.topicPublishes.size()}>0 )
${sharp}include "rclcpp_lifecycle/lifecycle_publisher.hpp"
#end
#if( ${rosParam.topicSubscribes.size()}>0 )
#foreach($topic in ${rosParam.topicSubscribes})
${sharp}include "${topic.messageType.toLowerCase()}.hpp"
#end
#end
#if( ${rosParam.parameters.size()}>0 )
${sharp}include "rcl_interfaces/msg/floating_point_range.hpp"
${sharp}include "rcl_interfaces/msg/integer_range.hpp"
${sharp}include "rcl_interfaces/msg/parameter_descriptor.hpp"
${sharp}include "rcl_interfaces/msg/set_parameters_result.hpp"
#end
#if( ${rosParam.serviceClients.size()}>0 || ${rosParam.serviceServers.size()}>0 )
${sharp}include "std_srvs/srv/set_bool.hpp"
${sharp}include "std_srvs/srv/trigger.hpp"
#end
${sharp}include <future>
${sharp}include <memory>
${sharp}include <string>
${sharp}include <vector>

namespace ${rosParam.packageName}
{

class ${rosParam.className} : public rclcpp_lifecycle::LifecycleNode
{
public:
#if( ${rosParam.actionClients.size()}>0 || ${rosParam.actionServers.size()}>0 )
#foreach($action in ${rosParam.actionClients})
  using ${tmpltHelper.capitalize(${action.name})} = ${tmpltHelper.convMessageType(${action.type})};
#end
#foreach($action in ${rosParam.actionServers})
  using ${tmpltHelper.capitalize(${action.name})} = ${tmpltHelper.convMessageType(${action.type})};
  using GoalHandle${tmpltHelper.capitalize(${action.name})} = rclcpp_action::ServerGoalHandle<${tmpltHelper.capitalize(${action.name})}>;
#end
#end

  explicit ${rosParam.className}(const rclcpp::NodeOptions & options = rclcpp::NodeOptions());
  ~${rosParam.className}() override = default;

  // ============================================================
  // Lifecycle callbacks
  // ============================================================

  rclcpp_lifecycle::node_interfaces::LifecycleNodeInterface::CallbackReturn
  on_configure(const rclcpp_lifecycle::State & state) override;

  rclcpp_lifecycle::node_interfaces::LifecycleNodeInterface::CallbackReturn
  on_activate(const rclcpp_lifecycle::State & state) override;

  rclcpp_lifecycle::node_interfaces::LifecycleNodeInterface::CallbackReturn
  on_deactivate(const rclcpp_lifecycle::State & state) override;

 #if(${rosParam.IsNotImplemented(3)}) //  #end rclcpp_lifecycle::node_interfaces::LifecycleNodeInterface::CallbackReturn
 #if(${rosParam.IsNotImplemented(3)}) //  #end on_cleanup(const rclcpp_lifecycle::State & state) override;

 #if(${rosParam.IsNotImplemented(4)}) //  #end rclcpp_lifecycle::node_interfaces::LifecycleNodeInterface::CallbackReturn
 #if(${rosParam.IsNotImplemented(4)}) //  #end on_shutdown(const rclcpp_lifecycle::State & state) override;

 #if(${rosParam.IsNotImplemented(5)}) //  #end rclcpp_lifecycle::node_interfaces::LifecycleNodeInterface::CallbackReturn
 #if(${rosParam.IsNotImplemented(5)}) //  #end on_error(const rclcpp_lifecycle::State & state) override;

private:
#if( ${rosParam.parameters.size()}>0 )
  // ============================================================
  // Parameter handling
  // ============================================================

  void declare_parameters();
  rclcpp::node_interfaces::OnSetParametersCallbackHandle::SharedPtr param_cb_handle_;
  rcl_interfaces::msg::SetParametersResult on_set_parameters(const std::vector<rclcpp::Parameter> & params);
#end
#if( ${rosParam.topicSubscribes.size()}>0 || ${rosParam.topicPublishes.size()}>0 )
  // ============================================================
  // Topic handles and callbacks
  // ============================================================

#foreach($topic in ${rosParam.topicPublishes})
  rclcpp_lifecycle::LifecyclePublisher<${tmpltHelper.convMessageType(${topic.messageType})}>::SharedPtr ${topic.varCallbackName}_;
#end
#foreach($topic in ${rosParam.topicSubscribes})
  rclcpp::Subscription<${tmpltHelper.convMessageType(${topic.messageType})}>::SharedPtr ${topic.name}_sub_;
  void ${topic.varCallbackName}(const ${tmpltHelper.convMessageType(${topic.messageType})}::SharedPtr msg);
#end

#end
#if( ${rosParam.serviceClients.size()}>0 || ${rosParam.serviceServers.size()}>0 )
  // ============================================================
  // Service handles and callbacks
  // ============================================================

#foreach($service in ${rosParam.serviceClients})
  rclcpp::Client<${tmpltHelper.convMessageType(${service.type})}>::SharedPtr ${service.varCallbackName}_;
  void ${service.varCallbackName}_service();
#end
#foreach($service in ${rosParam.serviceServers})
  rclcpp::Service<${tmpltHelper.convMessageType(${service.type})}>::SharedPtr ${service.name}_srv_;
  void ${service.name}_callback(const std::shared_ptr<${tmpltHelper.convMessageType(${service.type})}::Request> request, std::shared_ptr<${tmpltHelper.convMessageType(${service.type})}::Response> response);
#end

#end
#if( ${rosParam.actionClients.size()}>0 || ${rosParam.actionServers.size()}>0 )
  // ============================================================
  // Action handles and callbacks
  // ============================================================

#foreach($action in ${rosParam.actionClients})
  rclcpp_action::Client<${tmpltHelper.capitalize(${action.name})}>::SharedPtr ${action.name}_client_;
  void send_${action.name}_goal();
  void send_${action.name}_goal_response(rclcpp_action::ClientGoalHandle<${tmpltHelper.capitalize(${action.name})}>::SharedPtr goal_handle);
  void send_${action.name}_goal_feedback(rclcpp_action::ClientGoalHandle<${tmpltHelper.capitalize(${action.name})}>::SharedPtr, const std::shared_ptr<const ${tmpltHelper.capitalize(${action.name})}::Feedback> feedback);
  void send_${action.name}_goal_result(const rclcpp_action::ClientGoalHandle<${tmpltHelper.capitalize(${action.name})}>::WrappedResult & result);
#end
#foreach($action in ${rosParam.actionServers})
  rclcpp_action::Server<${tmpltHelper.capitalize(${action.name})}>::SharedPtr ${action.name}_server_;
  rclcpp_action::GoalResponse handle_goal_${action.name}(const rclcpp_action::GoalUUID & uuid, std::shared_ptr<const ${tmpltHelper.capitalize(${action.name})}::Goal> goal);
  rclcpp_action::CancelResponse handle_cancel_${action.name}(const std::shared_ptr<GoalHandle${tmpltHelper.capitalize(${action.name})}> goal_handle);
  void handle_accepted_${action.name}(const std::shared_ptr<GoalHandle${tmpltHelper.capitalize(${action.name})}> goal_handle);
  void ${action.name}(const std::shared_ptr<GoalHandle${tmpltHelper.capitalize(${action.name})}> goal_handle);
#end

#end
#if( ${rosParam.timers.size()}>0 )
  // ============================================================
  // Timer handles and callbacks
  // ============================================================

#foreach($timer in ${rosParam.timers})
  rclcpp::TimerBase::SharedPtr ${timer.name}_;
  void ${timer.callBack}();
#end
#end
};

}  // namespace ${rosParam.packageName}

${sharp}endif  // ${rosParam.packageName.toUpperCase()}__${rosParam.nodeName.toUpperCase()}_HPP_
