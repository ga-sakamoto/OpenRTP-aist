// ============================================================
// Topic callbacks
// ============================================================

#foreach($topic in ${rosParam.topicSubscribes})
void ${rosParam.className}::${topic.varCallbackName}(const ${tmpltHelper.convMessageType(${topic.messageType})}::SharedPtr msg)
{
  // Topic Subscriber callback: ${topic.name}
  // Type: ${topic.messageType}
  // Summary: ${topic.docDescription}
  // TODO: 受信したmsgを使って、このノードの処理を実装する。
  // Note: このcallbackは対象Topicにメッセージが届くたびに呼ばれる。
  (void)msg;
}

#end
