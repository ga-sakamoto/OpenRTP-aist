#if( ${rosParam.serviceClients.size()}>0 || ${rosParam.serviceServers.size()}>0)
// ============================================================
// Service callbacks and clients
// ============================================================

#foreach($service in ${rosParam.serviceClients})
void ${rosParam.className}::${service.varCallbackName}_service()
{
  // Service Client call: ${service.name}
  // Type: ${service.type}
  // Summary: ${service.docDescription}
  // Service Client helper: requestを作成してServerへ非同期送信する。
  if (!${service.varCallbackName}_) {
    RCLCPP_WARN(this->get_logger(), "Service client is not configured.");
    return;
  }
  auto request = std::make_shared<${tmpltHelper.convMessageType(${service.type})}::Request>();
  // TODO: このService呼び出し関数を呼び出すタイミングを実装する。
  // TODO: 使用するService型に合わせてrequestフィールドを設定する。
  // Note: request設定後、async_send_request()でService Serverへ送信する。
  auto future = ${service.varCallbackName}_->async_send_request(request);
  (void)future;
}

#end

#foreach($service in ${rosParam.serviceServers})
void ${rosParam.className}::${service.name}_callback(const std::shared_ptr<${tmpltHelper.convMessageType(${service.type})}::Request> request, std::shared_ptr<${tmpltHelper.convMessageType(${service.type})}::Response> response)
{
  // Service Server callback: ${service.name}
  // Type: ${service.type}
  // Summary: ${service.docDescription}
  // TODO: requestを読み取り、Serviceで実行する処理を実装する。
  // TODO: responseに返す値を設定する。
  (void)request;
  (void)response;
}

#end
#end
#if( ${rosParam.actionClients.size()}>0 || ${rosParam.actionServers.size()}>0)
// ============================================================
// Action callbacks and clients
// ============================================================

#foreach($action in ${rosParam.actionClients})
void ${rosParam.className}::send_${action.name}_goal()
{
  // Action Client goal sender: ${action.name}
  // Type: ${action.type}
  // Summary: ${action.docDescription}
  // Action Client helper: Goalを作成してAction Serverへ送信する。
  if (!${action.name}_client_) {
    RCLCPP_WARN(this->get_logger(), "Action client is not configured.");
    return;
  }
  // TODO: このGoal送信関数を呼び出すタイミングを実装する。
  // Note: Action型ごとにGoalフィールドが異なるため、生成器では具体値を設定しない。
  // TODO: Goalを作成し、response / feedback / result callbackを設定して送信する。
  RCLCPP_WARN(this->get_logger(), "Goal send skeleton is disabled. Implement goal send code before use.");
  return;
}

void ${rosParam.className}::send_${action.name}_goal_response(rclcpp_action::ClientGoalHandle<${tmpltHelper.capitalize(${action.name})}>::SharedPtr goal_handle)
{
  // Action Client goal response callback: ${action.name}
  // Type: ${action.type}
  // Summary: ${action.docDescription}
  if (!goal_handle) {
    RCLCPP_ERROR(this->get_logger(), "Goal rejected");
    return;
  }
  RCLCPP_INFO(this->get_logger(), "Goal accepted");
}

void ${rosParam.className}::send_${action.name}_goal_feedback(rclcpp_action::ClientGoalHandle<${tmpltHelper.capitalize(${action.name})}>::SharedPtr, const std::shared_ptr<const ${tmpltHelper.capitalize(${action.name})}::Feedback> feedback)
{
  // Action Client feedback callback: ${action.name}
  // Type: ${action.type}
  // Summary: ${action.docDescription}
  // TODO: 必要に応じてFeedbackを使った処理を実装する。
  (void)feedback;
}

void ${rosParam.className}::send_${action.name}_goal_result(const rclcpp_action::ClientGoalHandle<${tmpltHelper.capitalize(${action.name})}>::WrappedResult & result)
{
  // Action Client result callback: ${action.name}
  // Type: ${action.type}
  // Summary: ${action.docDescription}
  // TODO: 必要に応じてResultを使った処理を実装する。
  (void)result;
}

#end
#foreach($action in ${rosParam.actionServers})
rclcpp_action::GoalResponse ${rosParam.className}::handle_goal_${action.name}(const rclcpp_action::GoalUUID & uuid, std::shared_ptr<const ${tmpltHelper.capitalize(${action.name})}::Goal> goal)
{
  // Action Server goal callback: ${action.name}
  // Type: ${action.type}
  // Summary: ${action.docDescription}
  (void)uuid;
  (void)goal;
  return rclcpp_action::GoalResponse::ACCEPT_AND_EXECUTE;
}

rclcpp_action::CancelResponse ${rosParam.className}::handle_cancel_${action.name}(const std::shared_ptr<GoalHandle${tmpltHelper.capitalize(${action.name})}> goal_handle)
{
  // Action Server cancel callback: ${action.name}
  // Type: ${action.type}
  // Summary: ${action.docDescription}
  (void)goal_handle;
  return rclcpp_action::CancelResponse::ACCEPT;
}

void ${rosParam.className}::handle_accepted_${action.name}(const std::shared_ptr<GoalHandle${tmpltHelper.capitalize(${action.name})}> goal_handle)
{
  // Action Server accepted callback: ${action.name}
  // Type: ${action.type}
  // Summary: ${action.docDescription}
  std::thread{std::bind(&${rosParam.className}::${action.name}, this, std::placeholders::_1), goal_handle}.detach();
}

void ${rosParam.className}::${action.name}(const std::shared_ptr<GoalHandle${tmpltHelper.capitalize(${action.name})}> goal_handle)
{
  // Action Server execute callback: ${action.name}
  // Type: ${action.type}
  // Summary: ${action.docDescription}
  const auto goal = goal_handle->get_goal();
  auto result = std::make_shared<${tmpltHelper.capitalize(${action.name})}::Result>();

  // TODO: Goalを読み取り、Actionの実行処理を実装する。
  // TODO: 必要に応じてFeedbackとResultを設定する。
  (void)goal;

  goal_handle->succeed(result);
}

#end
#end
